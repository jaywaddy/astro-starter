---
import type { HTMLTag } from "astro/types";

type Props = { class?: string; id?: string; tag?: HTMLTag; varient?: string };

const { class: className, id, tag: Tag = "div", varient } = Astro.props;
---

<Tag
	{id}
	class:list={[
		"grid grid-cols-(--site-grid) gap-4",
		"[--site-grid:auto_1fr_auto]",
		"sm:[--site-grid:var(--grid-sm)]",
		"lg:[--site-grid:var(--grid-md)]",
		"2xl:[--site-grid:var(--grid-lg)]",
		className,
	]}
	data-varient={varient}
>
	<slot />
</Tag>
