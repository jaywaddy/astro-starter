---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { calcReadTime, formatDate, slugify } from "@lib/utils";
import Seperator from "@components/ui/Seperator.astro";
import Image from "@components/ui/Img.astro";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { TCollection } from "@lib/types";
import TableOfContents from "@components/TableOfContents.astro";

type Props = { entry: CollectionEntry<TCollection> };

const { entry } = Astro.props ?? {};

const { Content, headings } = await render(entry);
const { dateCreated, dateUpdated, title, description, thumbnail } = entry.data ?? {};
---

<GlobalLayout {...entry.data}>
	<GlobalGrid class="mt-8">
		<Container layout="content">
			<Image src={thumbnail} class="rounded-cta" />
		</Container>
	</GlobalGrid>
	<GlobalGrid class="mt-16">
		<Container layout="sidebar">
			<TableOfContents {headings} />
		</Container>
		<Container class="flex flex-col gap-8" layout="article" tag="article">
			<div class="flex flex-col gap-4">
				<h1>{title}</h1>
				<p class="lead">{description}</p>
				<div class="items center flex gap-2">
					<small>{formatDate(dateUpdated || dateCreated)}</small>
					<Seperator />
					<small>{calcReadTime(entry.body)}</small>
				</div>
			</div>
			<div class="content">
				<Content />
			</div>
		</Container>
	</GlobalGrid>
</GlobalLayout>
