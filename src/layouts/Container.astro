---
import type { HTMLTag } from "astro/types";
import { setWarning } from "../lib/utils";

type TGridLayout =
	| "full"
	| "body"
	| "content"
	| "article"
	| "sidebar"
	| "left-gutter"
	| "right-gutter"
	| "right-margin"
	| "left-margin"
	| "footer-info"
	| "footer-links";

type Props = {
	class?: string;
	id?: string;
	layout: TGridLayout;
	style?: string;
	tag?: HTMLTag;
	//
};

const { class: className, id, layout, style, tag: Tag = "div" } = Astro.props;

if (!layout) {
	setWarning("Container", "layout");
	return null;
}

const layouts: { [layout in TGridLayout]: string[] } = {
	"full": ["col-span-full"],
	"body": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-2 lg:col-end-10",
		"2xl:col-start-2 2xl:col-end-14",
	],
	"content": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-3 lg:col-end-9",
		"2xl:col-start-3 2xl:col-end-13",
	],
	"article": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-5 lg:col-end-9",
		"2xl:col-start-6 2xl:col-end-13",
	],
	"sidebar": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-3 lg:col-end-5",
		"2xl:col-start-3 2xl:col-end-6",
	],
	"left-gutter": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-2 lg:col-end-3",
		"2xl:col-start-2 2xl:col-end-3",
	],
	"right-gutter": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-9 lg:col-end-10",
		"2xl:col-start-13 2xl:col-end-14",
	],
	"left-margin": [
		"max-lg:hidden",
		"lg:col-start-1 lg:col-end-2",
		"2xl:col-start-1 2xl:col-end-2",
	],
	"right-margin": [
		"max-lg:hidden",
		"lg:col-start-10 lg:col-end-11",
		"2xl:col-start-14 2xl:col-end-15",
	],
	"footer-info": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-2 lg:col-end-4",
		"2xl:col-start-2 2xl:col-end-5",
	],
	"footer-links": [
		"col-start-2 col-end-3",
		"sm:col-start-2 sm:col-end-6",
		"lg:col-start-4 lg:col-end-10",
		"2xl:col-start-5 2xl:col-end-14",
	],
};
---

<Tag {id} {style} class:list={[...layouts[layout], className]}>
	<slot />
</Tag>
