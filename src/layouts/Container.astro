---
import type { HTMLTag } from "astro/types";
import GLOBAL_DATA from "../lib/globalData";

type TGridLayout =
	| "full"
	| "body"
	| "content"
	| "article"
	| "sidebar"
	| "left-gutter"
	| "right-gutter";

type Props = { class?: string; id?: string; layout: TGridLayout; style?: string; tag?: HTMLTag };
const { class: className, id, layout, style, tag } = Astro.props;

if (!layout) {
	GLOBAL_DATA.warn("Container", "layout");
	return null;
}

const layouts: { [layout in TGridLayout]: string } = {
	"full": "col-span-full",
	"body": "col-start-2 col-end-10",
	"content": "col-start-3 col-end-9", // Add mobile breakpoints...
	"article": "col-start-3 col-end-7", // Add mobile breakpoints...
	"sidebar": "col-start-7 col-end-9", // Add mobile breakpoints...
	"left-gutter": "col-start-2 col-end-3",
	"right-gutter": "col-start-9 col-end-10",
};

const Tag = tag || "div";
---

<Tag {id} {style} class:list={[layouts[layout], className]}>
	<slot />
</Tag>
