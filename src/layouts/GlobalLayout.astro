---
import AstroSeo from "@components/AstroSeo.astro";
import "../styles/global.css";
import type { TSeo } from "../components/AstroSeo.astro";
import Font from "astro/components/Font.astro";

type Props = { data: TSeo };

const { data } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<AstroSeo {data} />
		<Font cssVariable="--font-inter" preload />
		<script type="module" src="/scripts/toggleTheme.js" defer></script>
		<script type="module" src="/scripts/toggleMobileMenu.js" defer></script>
	</head>
	<body data-theme="light">
		<slot />
	</body>
</html>
