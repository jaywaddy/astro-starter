---
import Container from "../layouts/Container.astro";
import GlobalGrid from "../layouts/GlobalGrid.astro";
import GlobalLayout from "../layouts/GlobalLayout.astro";
import GLOBAL_DATA from "../lib/globalData";

const { brand } = GLOBAL_DATA;

const seo = { title: "Home" };
---

<GlobalLayout data={seo}>
	<GlobalGrid>
		<Container class="h-[200vh]" layout="content">
			<h1>{brand.name}</h1>
		</Container>
	</GlobalGrid>
</GlobalLayout>
