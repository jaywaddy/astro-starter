---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { Content, frontmatter } from "./contact.md";
import ContactForm from "@components/ContactForm.astro";
import Element from "@components/ui/Element.astro";
import type { TIcon } from "@components/ui/Icon.astro";
import type { TCta } from "@lib/types";
import Icon from "@components/ui/Icon.astro";
import Button from "@components/ui/Button.astro";
import globalConfig from "@lib/config";
import { setWarning } from "@lib/utils";

if (!globalConfig) {
	setWarning("Contact - index.astro", "globalConfig");
	return null;
}

type TSidebarGroup = { icon: TIcon; label: string; links?: TCta[]; text?: string };

const { email, location } = globalConfig.brand?.contact ?? {};
const { socialLinks } = globalConfig.brand ?? {};

const sidebarGroups: TSidebarGroup[] = [
	{ icon: "mail", label: "Email", text: email },
	{ icon: "location", label: "Location", text: location },
	{ icon: "message", label: "Connect", links: socialLinks },
];
---

<GlobalLayout {...frontmatter}>
	<GlobalGrid class="mt-8 gap-y-8">
		<Container layout="sidebar" tag="aside">
			<ul class="flex flex-col gap-4">
				{
					sidebarGroups.map(({ label, links, text }) => (
						<li class="flex flex-col gap-2">
							<small class="badge">{label}</small>
							<ul class="border-brand flex flex-col border-l-2 pl-4">
								{text && (
									<li>
										<small>{text}</small>
									</li>
								)}
								{links && (
									<li>
										<ul class="flex flex-wrap gap-2 [--color-cta-secondary:var(--color-primary)]">
											{links.map((link) => (
												<li>
													<Button {...link} varient="secondary" />
												</li>
											))}
										</ul>
									</li>
								)}
							</ul>
						</li>
					))
				}
			</ul>
		</Container>
		<Container class="flex flex-col gap-8" layout="article">
			<div>
				<Content />
			</div>
			<ContactForm data={globalConfig} />
		</Container>
	</GlobalGrid>
</GlobalLayout>
