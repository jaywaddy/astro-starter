---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { Content, getHeadings, frontmatter } from "./about.md";
import globalConfig from "@lib/config";
import { setWarning } from "@lib/utils";
import TableOfContents from "@components/TableOfContents.astro";

if (!globalConfig) {
	setWarning("About - index.astro", "globalConfig");
	return null;
}

const { bio } = globalConfig.brand ?? {};
const { title } = frontmatter;
---

<GlobalLayout {...frontmatter}>
	<GlobalGrid class="mt-8">
		<Container layout="sidebar">
			<TableOfContents headings={getHeadings()} />
		</Container>
		<Container class="flex flex-col gap-16" layout="article">
			<div>
				<h1>{title}</h1>
				<p class="lead">{bio}</p>
			</div>
			<div class="content mt-4 flex flex-col gap-8 [&>*>h2]:mt-8">
				<Content />
			</div>
		</Container>
	</GlobalGrid>
</GlobalLayout>
