---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { Content, frontmatter } from "./about.md";
import globalConfig from "@lib/config";
import { setWarning } from "@lib/utils";

if (!globalConfig) {
	setWarning("About - index.astro", "globalConfig");
	return null;
}

const { bio } = globalConfig.brand ?? {};
const { title } = frontmatter;
---

<GlobalLayout {...frontmatter}>
	<GlobalGrid>
		<Container layout="content">
			<h1>{title}</h1>
			<p class="lead">{bio}</p>
		</Container>
		<Container layout="article">
			<article class="mt-4 flex flex-col gap-8 [&>*>h2]:mt-8">
				<Content />
			</article>
		</Container>
	</GlobalGrid>
</GlobalLayout>
