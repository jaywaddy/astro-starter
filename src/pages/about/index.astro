---
import { getEntry } from "astro:content";
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";
import GlobalLayout from "../../layouts/GlobalLayout.astro";
import { frontmatter } from "./about.md";

const data = await getEntry("global", "navigation");

const { title } = frontmatter;
---

<GlobalLayout {...frontmatter}>
	<GlobalGrid>
		<Container layout="content">
			<h1>{title}</h1>
			<p class="lead">This will be the bio...</p>
		</Container>
	</GlobalGrid>
</GlobalLayout>
