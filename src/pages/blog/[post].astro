---
import { getCollection } from "astro:content";
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { calcReadTime, formatDate, slugify } from "@lib/utils";
import Seperator from "@components/ui/Seperator.astro";
import Image from "@components/ui/Img.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({ params: { post: slugify(post.data.title) }, props: { post } }));
}

const { body, data } = Astro.props.post ?? {};
const { Content } = await render(Astro.props.post);
const { dateCreated, dateUpdated, title, description } = data ?? {};
---

<GlobalLayout {...data}>
	<GlobalGrid>
		<Container class="flex flex-col gap-8" layout="article">
			<Image class="rounded-cta" />
			<div class="flex flex-col gap-4">
				<h1>{title}</h1>
				<p class="lead">{description}</p>
				<div class="items center flex gap-2">
					<small>{formatDate(dateUpdated || dateCreated)}</small>
					<Seperator />
					<small>{calcReadTime(body)}</small>
				</div>
			</div>
		</Container>
		<Container class="content" layout="article" tag="article">
			<Content />
		</Container>
	</GlobalGrid>
</GlobalLayout>
