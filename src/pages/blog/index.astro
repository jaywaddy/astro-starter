---
import type { TSeo } from "@components/AstroSeo.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import Container from "@layouts/Container.astro";
import { getCollection } from "astro:content";
import { calcReadTime, formatDate, setHref, slugify } from "@lib/utils";
import Seperator from "@components/ui/Seperator.astro";

const getPosts = await getCollection("blog");
const posts = getPosts.sort((older, newer) => {
	return newer.data.dateCreated.valueOf() - older.data.dateCreated.valueOf();
});

const data: TSeo = {
	title: "Blog",
	description: "Description",
	//
};
---

<GlobalLayout {...data}>
	<GlobalGrid>
		<Container layout="content">
			<h1>Blog</h1>
		</Container>
		<Container layout="content">
			<ul class="flex flex-col gap-8">
				{
					posts.map((post) => (
						<li class="flex flex-col gap-1">
							<a class="w-fit hover:underline" href={setHref(post)}>
								<strong>{post.data.title}</strong>
							</a>
							<div class="flex items-center gap-2">
								<small class="opacity-50">
									{formatDate(post.data.dateCreated)}
								</small>
								<Seperator />
								<small class="opacity-50">{calcReadTime(post.body)}</small>
							</div>
						</li>
					))
				}
			</ul>
		</Container>
	</GlobalGrid>
</GlobalLayout>
