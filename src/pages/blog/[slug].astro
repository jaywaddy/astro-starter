---
import { getCollection } from "astro:content";
import Container from "../../layouts/Container.astro";
import GlobalGrid from "../../layouts/GlobalGrid.astro";
import GlobalLayout from "../../layouts/GlobalLayout.astro";
import { calcReadTime, formatDate } from "@lib/utils";
import Seperator from "@components/ui/Seperator.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
		//
	}));
}

const { body, data, rendered } = Astro.props.post ?? {};
const { dateCreated, dateUpdated, title, metaTitle, description, metaDescription } = data ?? {};
---

<GlobalLayout {...data}>
	<GlobalGrid>
		<Container class="flex flex-col gap-4" layout="article">
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			<div class="items center flex gap-2">
				<small>{formatDate(dateCreated)}</small>
				<Seperator />
				<small>{calcReadTime(body)}</small>
			</div>
		</Container>
		<Container class="mt-4 flex flex-col gap-8 [&>*>h2]:mt-8" layout="article">
			<article class="flex flex-col gap-4" set:html={rendered?.html} />
		</Container>
	</GlobalGrid>
</GlobalLayout>
