---
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import GlobalLayout from "@layouts/GlobalLayout.astro";
import { frontmatter } from "./pricing.md";
import globalConfig from "@lib/config";
import Tabs from "@components/ui/Tabs.astro";
import CardPlan from "@components/CardPlan.astro";
import Grid from "@components/ui/Grid.astro";

const { setWarning } = globalConfig.utils ?? {};

if (!globalConfig) {
	setWarning("Contact - index.astro", "globalConfig");
	return null;
}

const { title, description } = frontmatter ?? {};

const services = globalConfig.services;
---

<GlobalLayout {...frontmatter}>
	<GlobalGrid class="gap-y-8">
		<Container class="flex flex-col gap-8" layout="content">
			<div class="flex max-w-[60ch] flex-col gap-4">
				<h1>{title}</h1>
				<p class="lead">{description}</p>
			</div>
			<Tabs id="pricing-tabs" tabs={["Pay Monthly", ["Pay Yearly", true], "Pay Once"]} />
			<Grid class="w-full gap-4" size="sm" tag="ul">
				{
					services.map((service) => (
						<li class="w-full">
							<CardPlan plan={service} />
						</li>
					))
				}
			</Grid>
		</Container>
	</GlobalGrid>
</GlobalLayout>
