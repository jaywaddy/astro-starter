---
export type TSeo = {
	canonicalUrl?: string;
	description?: string;
	metaDescription?: string;
	metaTitle?: string;
	name?: string;
	title?: string;
};

type Props = TSeo;

const { canonicalUrl, description, metaDescription, metaTitle, name, title } = Astro.props;
---

<>
	<title>{title} | {name}</title>
	<meta property="og:title" content={metaTitle || title} />
	<meta property="og:image" content="" />
	<!-- OG:Image - Needs attention... -->
	<meta name="description" content={`${metaDescription || description} - ${name}`} />
	<meta property="og:description" content={`${metaDescription || description} - ${name}`} />
	{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
</>
