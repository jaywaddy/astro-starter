---
import type { TCta } from "@lib/types";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import globalConfig from "@lib/config";
import { capitalize, setWarning } from "@lib/utils";

if (!globalConfig) {
	setWarning("Bread Crumbs", "globalConfig");
	return null;
}

type Props = { path: string; title: string | undefined };

const { path, title } = Astro.props;

const crumbs = path.split("/");
const lastCrumb = crumbs.length - 1;

const crumbList: TCta[] = crumbs.map((_crumb, _index) => {
	const setHref = () => {
		if (_index > 0 && _index < crumbs.length) {
			return crumbs.slice(0, _index + 1).join("/");
		}

		return "/";
	};

	const setLabel = () => {
		if (_index == lastCrumb) {
			return title;
		}

		if (_index === 0) {
			return "Home";
		}

		return capitalize(_crumb);
	};

	return {
		href: setHref(),
		label: _crumb === "" ? globalConfig.brand?.name : setLabel() || "",
		icon: _index === 0 ? "home" : undefined,
		varient: "ghost",
		iconOnly: _index === 0,
	};
});
---

<ul class="flex gap-2">
	{
		crumbList.map((crumb, index) => (
			<li class:list={["flex items-center gap-2"]}>
				{index > 0 && <Icon class="text-50 w-4" name="chevron-right" />}
				<Button
					class:list={["w-fit", index !== lastCrumb && "text-50 hover:text-100"]}
					{...crumb}
				/>
			</li>
			//
		))
	}
</ul>
