---
import { setHref } from "@lib/utils";
import { getCollection } from "astro:content";
import Button from "./ui/Button.astro";

type Props = { collection?: "blog" | "global" };

const { collection } = Astro.props;

if (!collection) {
	return null;
}

const collectionList = await getCollection(collection);
---

<div class="absolute">
	<ul class="menu bg-secondary rounded-element mt-4 flex flex-col gap-2 p-4">
		{
			collectionList.map((enrty) => (
				<li>
					<Button
						class="w-fit"
						label={enrty.data.title}
						href={setHref(enrty)}
						varient="link"
						icon={collection}
					/>
				</li>
			))
		}
		<li>
			<Button href={`/${collection}`} label="View all" icon={["arrow-right", "right"]} />
		</li>
	</ul>
</div>
