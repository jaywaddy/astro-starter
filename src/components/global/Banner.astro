---
import Button from "@components/ui/Button.astro";
import Container from "@layouts/Container.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";

import { data } from "@src/content.config";
import { setWarning } from "@lib/utils";

if (!data) {
	setWarning("Footer", "data");
	return null;
}

const { cta, display, label, varient } = data.banner ?? {};

if (!display) {
	return null;
}
---

<GlobalGrid class="bg-banner text-banner-text relative" varient={varient.toString()} id="banner">
	<Container layout="body" class="relative flex items-center justify-between py-1">
		<div class="mx-auto flex min-h-8 items-center gap-2">
			<small class="flex gap-2">
				<span class="text-nowrap">{label}</span>
				<span>&mdash;</span>
			</small>
			<Button
				class="[--color-cta-secondary-hover:var(--color-zinc-400)] [--color-cta-secondary:var(--color-zinc-500)]"
				{...cta}
				varient={["secondary", "sm"]}
			/>
		</div>
		{
			varient === "manual-hide" && (
				<Button
					class="absolute right-0"
					label="Close banner"
					icon={["close"]}
					iconOnly
					id="dismiss-button"
					varient="ghost"
				/>
			)
		}
	</Container>
</GlobalGrid>
<script>
	const banner = document.getElementById("banner");
	const dismissButton = document.getElementById("dismiss-button");

	if (banner && dismissButton) {
		const timestamp = Date.now().toString();

		dismissButton.addEventListener("click", () => {
			banner.style.display = "none";
			banner.dataset.hidden = "true";
			localStorage.setItem("hideBanner", "true");
			localStorage.setItem("hideBannerTimestamp", timestamp);
		});
	}
</script>
