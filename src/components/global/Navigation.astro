---
import Button from "../ui/Button.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import Container from "@layouts/Container.astro";
import Seperator from "@components/ui/Seperator.astro";
import Svg from "@components/ui/Svg.astro";

import logo from "@assets/logo.svg";
import { setWarning } from "@lib/utils";
import globalConfig from "@lib/config";
import MegaMenu from "@components/MegaMenu.astro";

if (!globalConfig) {
	setWarning("Navigation", "globalConfig");
	return null;
}

const { background, categories, cta, position } = globalConfig.navigation ?? {};

const backgroundColors: { [key in typeof background]: string } = {
	dynamic: "bg-base",
	static: "bg-primary",
};

const navPosition = () => {
	switch (position) {
		case "center":
			return "mx-auto";
		case "right":
			return "ml-auto";
		case "left":
			return "mr-auto";
		default:
			setWarning("Navigation", "position");
			return undefined;
	}
};
---

<GlobalGrid class:list={["relative py-4", backgroundColors[background]]} id="navigation">
	<Container class="flex items-center gap-12" layout="body">
		<a aria-label="Home" class="hover:text-50 flex items-center gap-2" href="/">
			<Svg class="[&_svg]:h-8" src={logo} />
			<small class="font-bold">{globalConfig.brand?.name}</small>
		</a>
		<nav class:list={["flex items-center gap-12", navPosition()]}>
			<ul class="flex items-center gap-2">
				{
					categories.map((link) => (
						<li class="[--menu-y:-100%] hover:[--menu-y:0%] [&_.mega-menu-container]:pointer-events-none hover:[&_.mega-menu-container]:pointer-events-auto hover:[&_.collection]:[&_svg]:-rotate-90">
							<Button class="nav-link" {...link} varient="ghost" />
							<MegaMenu collection={link.collection} />
						</li>
					))
				}
			</ul>
		</nav>
		<div
			class:list={[
				"flex items-center justify-end gap-4",
				"**:data-[theme='light']:[&_#theme-dark-icon]:hidden **:data-[theme='dark']:[&_#theme-light-icon]:hidden",
			]}
		>
			<Button
				id="theme-toggle-button"
				label="Toggle theme"
				varient="ghost"
				icons={[["theme-light"], ["theme-dark"]]}
				iconOnly
			/>
			<Seperator />
			<Button {...cta} />
		</div>
	</Container>
</GlobalGrid>
