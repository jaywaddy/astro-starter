---
import Button from "../ui/Button.astro";
import GlobalGrid from "@layouts/GlobalGrid.astro";
import Container from "@layouts/Container.astro";
import type { TIcon } from "@components/ui/Icon.astro";
import Icon from "@components/ui/Icon.astro";
import Svg from "@components/ui/Svg.astro";
import type { TCta } from "@lib/types";
import { allCollections } from "@src/content.config";

import globalConfig from "@lib/config";
import logo from "@assets/logo.svg";
import { setHref, setWarning } from "@lib/utils";
import type { CollectionEntry } from "astro:content";
import type { TCollection } from "@lib/types";
import Grid from "@components/ui/Grid.astro";
import ContactSidebar from "@components/ContactSidebar.astro";

if (!globalConfig) {
	setWarning("Footer", "globalConfig");
	return null;
}

type TFooterGroup = { icon?: TIcon; label: string; links: TCta[] };

const { brand, navigation } = globalConfig ?? {};
const {} = brand ?? {};

const navLinks: TCta[] = navigation.categories.filter((link) => {
	return link.href !== "/" && !link.collection;
});

const footerGroups = [
	{ label: "Information", links: [...navLinks] },
	...populateFooterGroups(...allCollections),
	//
];

function populateFooterGroups(...data: CollectionEntry<TCollection>[][]): TFooterGroup[] {
	const maxLinks = 5;

	return data
		.slice(0, maxLinks)
		.map((entries) => ({
			icon: entries[0]?.collection,
			label: entries[0]?.collection,
			links: entries.map((entry) => ({ href: setHref(entry), label: entry.data.title })),
		}));
}
---

<GlobalGrid class="bg-primary mt-auto gap-y-8 pt-8">
	<Container layout="body">
		<div class="grid grid-cols-(--grid-footer) gap-8 max-md:grid-cols-1">
			<div
				class="border-outline mr-8 flex flex-col gap-8 py-4 pr-8 max-md:border-b max-md:pb-16 md:border-r"
			>
				<a
					href="/"
					aria-label="Home"
					class="hover:text-50 flex flex-wrap items-center gap-2 text-sm"
				>
					<Svg class="[&_svg]:h-8" src={logo} />
					<span class="font-bold">{globalConfig.brand?.name}</span>
				</a>
				<ContactSidebar iconOnly varient="secondary" />
			</div>
			<Grid class="gap-x-8 gap-y-16 py-4" size="sm">
				{
					footerGroups.map(({ label, links }) => (
						<ul class="flex flex-col gap-2">
							<li>
								<span class="eyebrow">{label}</span>
							</li>
							{links.map(({ href, label }) => (
								<li class="">
									<a class="link" {href}>
										{label}
									</a>
								</li>
							))}
						</ul>
					))
				}
			</Grid>
		</div>
	</Container>
	<Container layout="full" tag="small" class="bg-banner flex justify-center py-4 text-[white]">
		<div class="flex flex-wrap gap-1 px-4 text-current">
			<span>Copyright &copy;</span>
			<span id="copyright-text"></span>
			<span>{brand?.name}. All rights reserved.</span>
		</div>
	</Container>
</GlobalGrid>
<script>
	const copyrightElement = document.getElementById("copyright-text");
	const currentYear = new Date().getFullYear().toString();

	if (copyrightElement) {
		copyrightElement.innerText = copyrightElement.innerText = currentYear;
	}
</script>
