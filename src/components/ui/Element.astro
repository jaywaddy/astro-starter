---
import type { HTMLTag } from "astro/types";

type Props = {
	bg?: string;
	class?: string;
	tag?: HTMLTag;
	//
};

const { bg, class: className, tag = "div" } = Astro.props;
const Tag = tag;
---

<Tag
	class:list={[
		"p-element rounded-element flex flex-col gap-4",
		className,
		bg ? bg : "bg-primary",
	]}
>
	<slot />
</Tag>
