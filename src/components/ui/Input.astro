---
type Props = {
	id?: string;
	name?: string;
	label?: string;
	class?: string;
	type?: TInputFieldType;
	placeholder?: string;
	required?: boolean;
};

const { id, name, label, class: className, placeholder, required, type } = Astro.props ?? {};

type TInputFieldType =
	| "button"
	| "checkbox"
	| "color"
	| "date"
	| "datetime-local"
	| "email"
	| "file"
	| "hidden"
	| "image"
	| "month"
	| "number"
	| "password"
	| "radio"
	| "range"
	| "reset"
	| "search"
	| "submit"
	| "tel"
	| "text"
	| "textarea"
	| "time"
	| "url"
	| "week";

const defaultStyles = "bg-primary rounded-cta w-full resize-none px-4 py-2 placeholder:opacity-50";
---

<div class="flex flex-col gap-2">
	{
		label && (
			<label class="flex flex-col gap-2" for={id}>
				<small>
					{label}
					{required && <span class="text-error">*</span>}
				</small>
			</label>
		)
	}
	{
		type === "textarea" ? (
			<textarea
				class:list={[defaultStyles, className]}
				id={id || name}
				{name}
				{placeholder}
				rows="6"
				maxlength={1000}
				{required}
			/>
		) : (
			<input
				id={id || name}
				class:list={[defaultStyles, className]}
				type="text"
				{name}
				{placeholder}
				{required}
			/>
		)
	}
</div>
