---
import Icon, { type TIcon } from "./Icon.astro";

type TButtonSize = "sm" | "md" | "lg";
type TButtonStyle = "primary" | "secondary" | "ghost" | "outline" | "link";
type TIconPosition = "left" | "right";

type Props = {
	arriaCurrent?: "page" | undefined;
	bgHover?: string;
	varient?: [TButtonSize, TButtonStyle?];
	class?: string;
	collection?: string;
	href?: string;
	label?: string;
	icon?: TIcon | [TIcon, TIconPosition?];
	icons?: [TIcon, TIconPosition?][];
	iconOnly?: boolean;
	id?: string;
	isExternal?: boolean;
	isUnderlined?: boolean;
	noIcon?: boolean;
};

const {
	arriaCurrent,
	varient = ["md", "primary"],
	class: classAttribute,
	collection,
	href,
	label,
	icon = collection ? ["chevron-down", "right"] : ["none", "left"],
	icons,
	iconOnly = false,
	id,
	isExternal,
	isUnderlined,
	noIcon = false,
} = Astro.props;

const size = varient[0];
const style = varient[1] || "primary";
const iconName = typeof icon === "string" ? icon : icon[0] || "at-sign";
const iconPosition = typeof icon === "string" ? "left" : icon[1] || "left";
const target = isExternal ? "_blank" : undefined;

const buttonSizes: { [key in TButtonSize]: string } = {
	sm: iconOnly ? "px-1 pb-0.25" : "px-2 pb-0.25 text-sm",
	md: collection
		? "pl-3 pr-1 py-1.5 text-[0.875rem]"
		: iconOnly
			? "aspect-1/1 p-[calc(--spacing(1)+0.5px)]"
			: "px-3 py-1.5 text-[0.875rem]",
	lg: iconOnly ? "aspect-1/1 p-2" : "font-[500] px-4 py-2",
};

const buttonStyles: { [key in TButtonStyle]: string } = {
	primary: "bg-cta-primary text-cta-primary-text hover:bg-cta-primary-hover outline-0.5",
	secondary: "bg-cta-secondary text-cta-secondary-text hover:bg-cta-secondary-hover",
	ghost: "hover:bg-cta-hover text-[0.875rem]",
	outline: "outline-outline outline hover:bg-cta-hover",
	link: "relative hover:after:absolute hover:after:-bottom-1 hover:after:left-0 hover:after:h-0.25 hover:after:w-full hover:after:bg-current hover:after:content-['']",
};

const iconPositions: { [key in TIconPosition]: string } = {
	left: "flex-row",
	right: "flex-row-reverse",
};

const iconStrokeWidths: { [key in TButtonSize]: string } = {
	sm: "[&_path]:stroke-[2px]",
	md: "[&_path]:stroke-[2.5px]",
	lg: "[&_path]:stroke-[2.8px]",
};

const CtaTag = href ? "a" : "button";
const LabelTag = size === "sm" ? "small" : "span";
---

<CtaTag
	{id}
	{href}
	{target}
	class:list={[
		"rounded-cta flex cursor-pointer items-center justify-center gap-1 text-nowrap [&_svg]:h-4",
		buttonSizes[size],
		isUnderlined && "underline",
		iconPositions[iconPosition],
		style !== "link" && `font-[450] ${buttonStyles[style]}`,
		classAttribute,
	]}
	aria-current={arriaCurrent}
>
	{
		iconName !== "none" && !icons && !noIcon && (
			<span class:list={[iconStrokeWidths[size], size === "sm" && "[&_svg]:w-3"]}>
				<Icon name={iconName} />
			</span>
		)
	}
	{
		icons &&
			!noIcon &&
			icons.map((_icon) => (
				<span
					id={`${_icon[0]}-icon`}
					class:list={[iconStrokeWidths[size], size === "sm" && "[&_svg]:w-3"]}
				>
					<Icon name={_icon[0]} />
				</span>
			))
	}
	{
		(!iconOnly || noIcon) && (
			<LabelTag class:list={[style === "link" && buttonStyles[style]]}>{label}</LabelTag>
		)
	}
</CtaTag>
