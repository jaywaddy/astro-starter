---
import {
	ArrowDown,
	ArrowLeft,
	ArrowRight,
	ArrowUp,
	AtSign,
	BookOpen,
	Box,
	Check,
	ChevronDown,
	ChevronLeft,
	ChevronRight,
	ChevronUp,
	CircleDot,
	Download,
	ExternalLink,
	Flame,
	Globe,
	Hammer,
	Handshake,
	House,
	Image,
	Mail,
	MapPin,
	Menu,
	MessageCircleHeart,
	Moon,
	Navigation,
	Newspaper,
	Pyramid,
	Radio,
	RefreshCw,
	Search,
	SendHorizontal,
	Sparkles,
	Sun,
	SunMoon,
	X,
} from "@lucide/astro";

import Bluesky from "@assets/icons/bluesky.svg";
import GitHub from "@assets/icons/github.svg";
import Gumroad from "@assets/icons/gumroad.svg";
import KoFi from "@assets/icons/ko-fi.svg";
import Sketchfab from "@assets/icons/sketchfab.svg";
import YouTube from "@assets/icons/youtube.svg";

const iconMap = {
	"arrow-down": ArrowDown,
	"arrow-left": ArrowLeft,
	"arrow-right": ArrowRight,
	"arrow-up": ArrowUp,
	"article": Newspaper,
	"at-sign": AtSign,
	"blog": Newspaper,
	"bluesky": Bluesky,
	"close": X,
	"chevron-down": ChevronDown,
	"chevron-left": ChevronLeft,
	"chevron-right": ChevronRight,
	"chevron-up": ChevronUp,
	"config": Globe,
	"download": Download,
	"external-link": ExternalLink,
	"flame": Flame,
	"gallery": Image,
	"github": GitHub,
	"guide": BookOpen,
	"gumroad": Gumroad,
	"handshake": Handshake,
	"home": House,
	"ko-fi": KoFi,
	"location": MapPin,
	"mail": Mail,
	"menu": Menu,
	"message": MessageCircleHeart,
	"model": Box,
	"navigation": Navigation,
	"new": Sparkles,
	"none": "",
	"open": Check,
	"quads": Box,
	"resource": Newspaper,
	"search": Search,
	"send": SendHorizontal,
	"sketchfab": Sketchfab,
	"stream": Radio,
	"theme": SunMoon,
	"theme-dark": Moon,
	"theme-light": Sun,
	"tool": Hammer,
	"tris": Pyramid,
	"update": RefreshCw,
	"verts": CircleDot,
	"video": YouTube,
	"youtube": YouTube,
};

export type TIcon = keyof typeof iconMap;
type Props = { class?: string; name: TIcon };

const { class: className, name } = Astro.props;

if (!name) return null;

const Icon = iconMap[name] ?? Fragment;
---

<Icon class:list={["fill-none", className]} />
