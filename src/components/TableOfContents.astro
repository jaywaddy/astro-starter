---
import globalConfig from "@lib/config";

type THeadings = { depth: number; slug: string; text: string };

type Props = { headings: THeadings[] };

const { headings } = Astro.props;
---

<aside class:list={["sticky top-32 flex flex-col gap-2", globalConfig.banner.display]}>
	<span class="text-brand eyebrow">On this page</span>
	<ol class="border-brand flex flex-col gap-2 border-l-2 pr-4 pl-4 text-sm">
		{
			headings.map(({ depth, slug, text }) =>
				depth === 2 ? (
					<li>
						<a class="text-balance hover:underline" href={`#${slug}`}>
							{text}
						</a>
					</li>
				) : (
					<ul class="pl-4">
						<li>
							<a class="hover:underline" href={`#${slug}`}>
								{text}
							</a>
						</li>
					</ul>
				),
			)
		}
	</ol>
</aside>
