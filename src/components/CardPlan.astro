---
import Element from "./ui/Element.astro";
import globalConfig from "@lib/config";
import Icon from "./ui/Icon.astro";
import Button from "./ui/Button.astro";

type Props = { plan: (typeof globalConfig.services)[0] };

const { slugify } = globalConfig.utils;
const { description, discount, features, featureTitle, highlighted, name, note, price } =
	Astro.props.plan;
const prices = {
	"pricing-tabs-pay-monthly": price.month,
	"pricing-tabs-pay-yearly": Math.round(price.annual / 12),
	"pricing-tabs-pay-once": price.annual,
};
const priceId = `service-${slugify(name)}`;
---

<Element
	bg={highlighted
		? "bg-[color-mix(var(--color-brand)_25%,transparent)] border border-brand"
		: undefined}
	class="relative h-full"
>
	{
		highlighted && (
			<small class="bg-brand text-cta-primary-text rounded-bl-cta rounded-tr-element absolute top-0 right-0 flex items-center gap-1 px-2 py-1">
				<Icon class="w-4 [&_path]:stroke-2" name="thumbs-up" /> Recommended
			</small>
		)
	}
	<strong>{name}</strong>
	<p>{description}</p>
	<div class="flex flex-col gap-1">
		<div class="flex items-end gap-2">
			<span class="text-3xl" id={`service-${slugify(name)}`}
				>${price.month.toLocaleString()} /mo</span
			>
			{discount > 0 && <small class="text-50">{discount * 100}% discount</small>}
		</div>
		{
			discount > 0 && (
				<span class="text-50 line-through" id={`service-${slugify(name)}-original`}>
					${price.month.toLocaleString()} /mo
				</span>
			)
		}
		{note && <small>{note}</small>}
	</div>
	<Button label="Get Started" />
	<div class="flex flex-col gap-1">
		<strong>{featureTitle}</strong>
		<ul>
			{
				features
					.filter((feature) => feature.list)
					.map(({ name }) => (
						<li class="flex gap-2">
							<Icon class="w-2.5 [&_path]:stroke-4" name="check" />
							<span>{name}</span>
						</li>
					))
			}
		</ul>
	</div>
</Element>
<script define:vars={{ discount, priceId, prices }}>
	const tabs = document.querySelectorAll("#pricing-tabs input[name='button-group']");
	const discountedPrice = document.getElementById(priceId);
	const originalPrice = document.getElementById(`${priceId}-original`);

	if (tabs) {
		tabs.forEach((tab) => {
			updatePrice(tab);
			tab.addEventListener("click", () => updatePrice(tab));
		});

		function updatePrice(tab) {
			if (tab.checked) {
				const id = tab.id;

				discountedPrice
					? (discountedPrice.innerText = `$${discountPrice(prices[id]).toLocaleString()}${id !== "pricing-tabs-pay-once" ? " /mo" : ""}`)
					: null;
				originalPrice
					? (originalPrice.innerText = `$${prices[id].toLocaleString()}${id !== "pricing-tabs-pay-once" ? " /mo" : ""}`)
					: null;
			}
		}
	}

	function discountPrice(price) {
		const discountAmount = price * discount;
		return Math.round(price - discountAmount);
	}
</script>
